# TenderLens Environment Variables Template
# Copy this to .env and fill in your keys (DO NOT commit .env to git)

# Live tender discovery (optional; required only for live portal searches)
TINYFISH_API_KEY=

# Clause/conflict analysis and live search fallback (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
OPENAI_API_KEY=

# Supabase Auth + Postgres (the publishable key is designed for browser use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Application Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4177,http://127.0.0.1:4177

# Supabase Cloud Database & Authentication (Free Tier)
# Get these from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional backend service key (for administrative operations):
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...

