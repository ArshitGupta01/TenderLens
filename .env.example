# TenderLens Environment Variables Template
# Copy this to .env and fill in your keys (DO NOT commit .env to git)

# TinyFish Web Intelligence Platform
TINYFISH_API_KEY=sk-tinyfish-your-key-here

# LLM Providers for Semantic Clause Verification
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Application Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development

# Supabase Cloud Database & Authentication (Free Tier)
# Get these from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional backend service key (for administrative operations):
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...

