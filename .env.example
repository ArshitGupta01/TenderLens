# TenderLens Environment Variables Template
# Copy this to .env and fill in your keys (DO NOT commit .env to git)

# TinyFish Web Intelligence Platform
TINYFISH_API_KEY=sk-tinyfish-your-key-here

# LLM Providers for Semantic Clause Verification
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Supabase Auth + Postgres (the publishable key is designed for browser use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Application Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4177,http://127.0.0.1:4177
