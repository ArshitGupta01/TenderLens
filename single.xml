.filter-chip.is-active { border-color: var(--green-dark); color: var(--surface); background: var(--green-dark); }
.filter-chip span { color: #e6bb7c; font: 8px var(--mono); }
.result-count { flex: 0 0 auto; color: #87938a; font: 8px var(--mono); letter-spacing: .04em; }
.tender-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
.tender-card { position: relative; display: flex; min-height: 286px; flex-direction: column; padding: 20px; border: 1px solid #d5d9d0; background: var(--surface); box-shadow: 0 6px 20px rgba(24, 51, 47, .025); transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
.tender-card:hover { transform: translateY(-4px); border-color: #9eb5a6; box-shadow: 0 18px 35px rgba(24, 51, 47, .08); }
.tender-card[hidden] { display: none; }
.tender-card-top { display: flex; align-items: center; justify-content: space-between; }
.portal-tag, .tender-category, .dialog-label { font: 8px var(--mono); letter-spacing: .09em; }
