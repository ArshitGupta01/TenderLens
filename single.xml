.check-row { display: grid; grid-template-columns: 25px minmax(0, 1fr) auto 15px; align-items: center; gap: 9px; width: 100%; padding: 11px 0; border: 0; border-bottom: 1px solid #edf0eb; color: inherit; background: transparent; text-align: left; cursor: pointer; }
