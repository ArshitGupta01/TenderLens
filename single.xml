@media (max-width: 850px) {
  .header-actions { margin-left: auto; }
  .footer-links { justify-content: flex-start; flex-wrap: wrap; gap: 10px 16px; }
  .guide-hero-grid, .guide-two-column { grid-template-columns: 1fr; gap: 28px; }
  .faq-layout { grid-template-columns: 1fr; gap: 18px; }
  .guide-note { max-width: 600px; }
  .guide-step-grid { grid-template-columns: 1fr; }
  .guide-step-card { min-height: 0; }
  .guide-final-card { align-items: flex-start; flex-direction: column; }
  .live-search-form { grid-template-columns: 1fr 1fr; }
  .live-search-submit { grid-column: 1 / -1; }
}
@media (max-width: 560px) {
  body { font-size: 16px; }
  .theme-toggle { width: 42px; min-width: 42px; justify-content: center; padding: 7px; }
  .theme-toggle > span:last-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
  .live-search-summary { grid-template-columns: 38px minmax(0, 1fr); gap: 10px; padding: 13px; }
  .live-search-symbol { width: 36px; height: 36px; }
  .live-search-open { grid-column: 2; }
  .live-search-content { padding-inline: 13px; }
