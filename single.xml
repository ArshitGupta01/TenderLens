          </details>
        </article>

        <!-- PILLAR 08: MANDATORY 25% MSE QUOTA GATEWAY -->
        <article class="strategy-output-card strategy-output-card-wide" style="border-left: 3px solid #7c3aed; grid-column: 1 / -1;">
          <div class="strategy-card-heading">
            <div>
