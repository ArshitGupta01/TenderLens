          &bull; <code>{{ .Email }}</code> &mdash; Recipient email address<br>
          &bull; <code>{{ .SiteURL }}</code> &mdash; Application root URL
        </div>
      </div>

      <div class="meta-card">
        <div class="meta-title">File Location in Project</div>
        <div class="meta-val" id="localFilePath" style="font-size: 12px; color: #a5b4fc;">supabase/templates/confirm_signup.html</div>
      </div>

      <div class="meta-card">
