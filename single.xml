  <script>
    const templates = {
      confirm_signup: {
        path: 'supabase/templates/confirm_signup.html',
        target: 'Confirm signup',
        subject: 'Confirm your TenderLens account',
        sampleUrl: 'https://qiwpkvjzqdyguygowzci.supabase.co/auth/v1/verify?token=pk_demo_749216&type=signup&redirect_to=http://127.0.0.1:4177/account.html',
        sampleToken: '849 203',
        sampleEmail: 'bidder@defence-aerospace.in'
      },
      reset_password: {
        path: 'supabase/templates/reset_password.html',
        target: 'Reset password',
        subject: 'Reset your TenderLens password',
        sampleUrl: 'https://qiwpkvjzqdyguygowzci.supabase.co/auth/v1/verify?token=pk_demo_982143&type=recovery&redirect_to=http://127.0.0.1:4177/account.html',
        sampleToken: '492 815',
        sampleEmail: 'procurement-officer@aerospace.in'
      },
      magic_link: {
        path: 'supabase/templates/magic_link.html',
        target: 'Magic Link',
        subject: 'Your TenderLens sign-in link',
        sampleUrl: 'https://qiwpkvjzqdyguygowzci.supabase.co/auth/v1/verify?token=pk_demo_384729&type=magiclink&redirect_to=http://127.0.0.1:4177/account.html',
        sampleToken: '620 918',
        sampleEmail: 'analyst@enterprise-tenders.com'
      },
      email_change: {
        path: 'supabase/templates/email_change.html',
        target: 'Change email address',
        subject: 'Confirm your email change',
        sampleUrl: 'https://qiwpkvjzqdyguygowzci.supabase.co/auth/v1/verify?token=pk_demo_552194&type=email_change&redirect_to=http://127.0.0.1:4177/account.html',
        sampleToken: '319 402',
        sampleEmail: 'new-officer@defence-aerospace.in'
      }
    };

    let activeKey = 'confirm_signup';
    let currentRawHtml = '';

    async function loadTemplate(key) {
      activeKey = key;
      const conf = templates[key];
      document.getElementById('supabaseTargetName').textContent = conf.target;
      document.getElementById('recommendedSubject').textContent = conf.subject;
      document.getElementById('localFilePath').textContent = conf.path;

      try {
        const res = await fetch(conf.path);
        currentRawHtml = await res.text();
        
        // Render with preview sample variables
        const rendered = currentRawHtml
          .replace(/\{\{\s*\.ConfirmationURL\s*\}\}/g, conf.sampleUrl)
          .replace(/\{\{\s*\.Token\s*\}\}/g, conf.sampleToken)
          .replace(/\{\{\s*\.Email\s*\}\}/g, conf.sampleEmail)
          .replace(/\{\{\s*\.SiteURL\s*\}\}/g, 'http://127.0.0.1:4177');

        const iframe = document.getElementById('previewIframe');
        iframe.srcdoc = rendered;
      } catch (err) {
        console.error('Failed to load template:', err);
      }
    }

    function switchTab(key) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = Array.from(document.querySelectorAll('.tab-btn')).find(b => b.getAttribute('onclick').includes(key));
      if (activeBtn) activeBtn.classList.add('active');
      loadTemplate(key);
    }

    function copyTemplateSource() {
      if (!currentRawHtml) return;
      navigator.clipboard.writeText(currentRawHtml).then(() => {
        const btn = document.getElementById('copyBtn');
        const original = btn.innerHTML;
        btn.innerHTML = `<svg width="14" height="14" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Copied to Clipboard!`;
        btn.style.borderColor = '#10b981';
        setTimeout(() => {
          btn.innerHTML = original;
          btn.style.borderColor = '';
        }, 2200);
      });
    }

    // Initial load
    loadTemplate('confirm_signup');
  </script>
</body>
</html>
