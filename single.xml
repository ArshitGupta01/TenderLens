                  id="certifications" name="held_certifications" maxlength="500"
                  placeholder="For example: ISO-9001, BIS, CE"></label>
            </div>
            <label class="profile-field" for="past-projects">Completed similar project values · ₹ lakh <small>Optional,
                comma-separated for CPWD 80/50/40 check</small><input id="past-projects"
                name="past_similar_project_values_lakhs" maxlength="300"
                placeholder="For example: 140, 110, 95"></label>
          </fieldset>

          <fieldset class="strategy-fieldset">
            <legend class="strategy-legend-header">
              <span><span>03</span> Tender requirements</span>
