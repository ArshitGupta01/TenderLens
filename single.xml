/* -------------------------------------------------------------------------
   Uncluttered Header & Interactive Flyout Menu
   (All previous banner components organized inside the Menu option)
   ------------------------------------------------------------------------- */
.top-menu-banner {
  display: none !important;
}

.site-header {
  position: sticky;
  z-index: 100;
  top: 0;
}

.nav-shell {
  position: relative;
}

.menu-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 40px;
  padding: 0 14px;
  border: 1px solid var(--line-strong);
  border-radius: 2px;
  background: var(--surface);
  color: var(--ink);
  font: 700 12px var(--mono);
  letter-spacing: .06em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all .16s ease;
}
.menu-toggle:hover {
  border-color: var(--green);
  color: var(--green);
}
.menu-lines {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 16px;
}
.menu-lines i {
  display: block;
  width: 16px;
  height: 2px;
  background: currentColor;
  transition: transform .2s ease;
}
.menu-toggle[aria-expanded="true"] .menu-lines i:first-child {
  transform: translateY(3px) rotate(45deg);
}
.menu-toggle[aria-expanded="true"] .menu-lines i:last-child {
  transform: translateY(-3px) rotate(-45deg);
}

/* Primary Nav Menu (Only visible when Menu is clicked) */
.primary-nav {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 340px;
  max-width: calc(100vw - 24px);
  max-height: min(75vh, 490px);
  overflow-y: auto !important;
  overscroll-behavior: contain;
  padding: 14px;
  background: var(--surface);
  border: 1px solid var(--line-strong);
  border-radius: 6px;
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.24);
  z-index: 250;
  flex-direction: column;
  gap: 10px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: var(--line-strong) transparent;
}
.primary-nav::-webkit-scrollbar {
  width: 5px;
}
.primary-nav::-webkit-scrollbar-track {
  background: transparent;
}
.primary-nav::-webkit-scrollbar-thumb {
  background: var(--line-strong);
  border-radius: 4px;
}
.primary-nav.is-open {
  display: flex !important;
  animation: menu-slide-in .16s ease-out;
}
@keyframes menu-slide-in {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}

.menu-status-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  background: var(--paper-deep);
  border: 1px solid var(--line);
  border-radius: 3px;
  font: 700 11px var(--mono);
  color: var(--green);
  letter-spacing: .06em;
}
.menu-pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
  animation: pulse-ring 2s infinite ease-out;
}
.menu-group {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.menu-section-heading {
  margin: 8px 4px 4px;
