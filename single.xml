.audience-copy h2 { font-size: clamp(40px, 4.5vw, 58px); }
.audience-copy > p:not(.eyebrow) { max-width: 420px; margin: 19px 0 25px; color: var(--muted); font-size: 12px; line-height: 1.8; }
.audience-tabs { display: flex; flex-wrap: wrap; gap: 7px; }
.audience-tab { padding: 8px 11px; border: 1px solid var(--line-strong); color: var(--ink-soft); background: transparent; font-size: 9px; font-weight: 600; cursor: pointer; transition: color .18s ease, background-color .18s ease, border-color .18s ease; }
.audience-tab:hover { border-color: var(--green); }
.audience-tab.is-active { border-color: var(--green-dark); color: var(--surface); background: var(--green-dark); }
.audience-display { border: 1px solid var(--line-strong); background: #fbfaf4; }
.audience-display-top, .audience-display-bottom { display: flex; justify-content: space-between; padding: 12px 17px; color: #87948c; font: 8px var(--mono); letter-spacing: .08em; }
.audience-display-top { border-bottom: 1px solid var(--line); }
.audience-display-bottom { border-top: 1px solid var(--line); }
.audience-content { display: grid; grid-template-columns: 155px 1fr; align-items: center; gap: 27px; min-height: 255px; padding: 25px 25px; }
.audience-illustration { display: grid; place-items: center; width: 150px; height: 170px; color: var(--green); background: var(--green-pale); }
