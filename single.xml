/* ==========================================================================
   TenderLens Dynamic Wordmark Hero & Aspect-Ratio Scaling System
   ========================================================================== */
.tenderlens-doodle-stage {
  position: relative;
  width: 100%;
  background: var(--bg-canvas, #090e17);
  box-sizing: border-box;
  overflow: hidden;
}

.tenderlens-doodle-sticky {
  width: 100%;
  box-sizing: border-box;
}

#tenderlens-doodle-root {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Ensure the Doodle Crew root renders ONLY the pure wordmark and crew */
#tenderlens-doodle-root .dcf {
  background: transparent !important;
  border-bottom: none !important;
  padding: 0 !important;
  min-height: unset !important;
  width: 100% !important;
}

/* Fluid responsive world container that scales with viewport width & aspect ratio */
#tenderlens-doodle-root .dcf-world {
  padding: clamp(8px, 2vw, 24px) clamp(12px, 3vw, 48px) !important;
  max-width: 100% !important;
  width: 100% !important;
  margin: 0 auto !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

#tenderlens-doodle-root .dcf-stage {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Fluid SVG sizing: scales dynamically with viewport width, height and aspect ratio */
#tenderlens-doodle-root .dcf-svg {
  display: block;
  width: clamp(290px, 95vw, 1780px);
  max-height: clamp(160px, 48vh, 460px);
  height: auto;
  margin: 0 auto;
  filter: drop-shadow(0 14px 40px rgba(0, 0, 0, 0.5));
  transition: width 0.2s ease, max-height 0.2s ease, transform 0.2s ease;
  user-select: none;
  -webkit-user-select: none;
}

.doodle-scroll-cue {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 10px 16px 20px;
  font-size: 0.8125rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #94a3b8;
  font-weight: 600;
  cursor: pointer;
  user-select: none;
  transition: color 0.2s ease;
  animation: doodleCueFloat 2.4s ease-in-out infinite;
}

.doodle-scroll-cue:hover {
  color: #38bdf8;
}

.doodle-scroll-cue svg {
  stroke: #38bdf8;
  transition: transform 0.2s ease;
}

.doodle-scroll-cue:hover svg {
  transform: translateY(4px);
}

@keyframes doodleCueFloat {
  0%, 100% {
    transform: translateY(0);
    opacity: 0.75;
  }
  50% {
    transform: translateY(6px);
    opacity: 1;
  }
}

/* ==========================================================================
   Aspect Ratio Responsive Scaling Rules
   ========================================================================== */

/* 1. Ultra-Wide Displays (e.g. 21:9, 18:9, aspect-ratio >= 2.0) */
@media (min-aspect-ratio: 18/9) and (min-width: 769px) {
  #tenderlens-doodle-root .dcf-svg {
    width: clamp(960px, 96vw, 1920px);
    max-height: 54vh;
  }
  .tenderlens-doodle-stage {
    min-height:  240px; max-height: 280px; padding: 20px 0 10px;
  }
}

/* 2. Standard Widescreen (16:9, 16:10, e.g. 1920x1080, 1440x900) */
@media (min-aspect-ratio: 14/9) and (max-aspect-ratio: 18/9) and (min-width: 769px) {
  #tenderlens-doodle-root .dcf-svg {
    width: clamp(780px, 95vw, 1760px);
    max-height: 50vh;
  }
  .tenderlens-doodle-stage {
    min-height:  240px; max-height: 280px; padding: 20px 0 10px;
  }
}

/* 3. Taller / Boxier Viewports (4:3, 5:4, iPad, vertical split screen) */
@media (max-aspect-ratio: 14/9) and (min-width: 769px) {
  #tenderlens-doodle-root .dcf-svg {
    width: clamp(620px, 94vw, 1480px);
    max-height: 42vh;
  }
  .tenderlens-doodle-stage {
    min-height:  240px; max-height: 280px; padding: 20px 0 10px;
  }
}

/* Desktop Long-Scroll Curtain Cover-Up Effect */
@media (min-width: 769px) {
  .tenderlens-doodle-stage {
    z-index: 1;
  }

  .tenderlens-doodle-sticky {
    position: sticky;
    top: 72px; /* Sits directly below the 72px sticky header banner */
    height: auto; min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 1;
    overflow: hidden;
    will-change: transform, opacity;
  }

  .tenderlens-curtain {
    position: relative;
    z-index: 25;
    background: var(--paper);
    box-shadow: 0 -20px 45px rgba(24, 51, 47, 0.12), 0 -1px 0 var(--line);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
}

/* ==========================================================================
   Mobile Devices: Fully Optimized UI & Seamless Touch Experience
   ========================================================================== */
@media (max-width: 768px) {
  .tenderlens-doodle-stage {
    position: relative !important;
    min-height: unset !important;
    height: auto !important;
    z-index: auto !important;
    padding: 16px 0 10px !important;
    overflow-x: hidden !important;
    touch-action: pan-y !important;
  }

  .tenderlens-doodle-sticky {
    position: relative !important;
    top: unset !important;
    height: auto !important;
    min-height: unset !important;
    overflow: visible !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: auto !important;
    transform: none !important;
    padding: 0 !important;
  }

  #tenderlens-doodle-root {
    min-height: unset !important;
    width: 100% !important;
    padding: 0 !important;
  }

  #tenderlens-doodle-root .dcf-world {
    padding: 4px 8px 8px !important;
    width: 100% !important;
    overflow-x: hidden !important;
  }

  #tenderlens-doodle-root .dcf-svg {
    /* Maximum legible width on mobile without causing horizontal overflow */
    width: 100% !important;
    max-width: calc(100vw - 16px) !important;
    height: auto !important;
    max-height: 220px !important;
    margin: 0 auto !important;
  }

  .tenderlens-curtain {
    position: relative !important;
    z-index: auto !important;
    box-shadow: none !important;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .doodle-scroll-cue {
    display: none !important;
  }
}

/* Extra small mobile devices (<= 380px, e.g. iPhone SE, small Androids) */
@media (max-width: 380px) {
  .tenderlens-doodle-stage {
    padding: 12px 0 6px !important;
  }

  #tenderlens-doodle-root .dcf-world {
    padding: 2px 4px 6px !important;
  }

  #tenderlens-doodle-root .dcf-svg {
    max-width: calc(100vw - 10px) !important;
    max-height: 180px !important;
  }
}

