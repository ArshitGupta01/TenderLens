              <h3>Exemption Audit &amp; Void Revocation Scanner</h3>
            </div>
          </div>
          <p class="strategy-output-copy" data-shield-summary></p>
          <div style="margin: 0.75rem 0;" data-shield-verdict-container></div>
          <dl class="strategy-metrics" data-shield-metrics></dl>
          <div style="margin-top: 1rem;">
