                ⚡ Autofill Applied Tender Requirements
              </button>
            </legend>
            <div class="strategy-input-grid strategy-input-grid-three">
              <label class="profile-field" for="min-turnover">Minimum turnover · ₹ lakh<input id="min-turnover"
                  name="min_annual_turnover_lakhs" type="number" min="0" step="0.01" required placeholder="0"></label>
              <label class="profile-field" for="min-experience">Minimum experience · years<input id="min-experience"
                  name="min_experience_years" type="number" min="0" max="150" step="1" required placeholder="0"></label>
              <label class="profile-field" for="estimated-value">Estimated bid value · ₹ lakh<input id="estimated-value"
                  name="estimated_bid_value_lakhs" type="number" min="0" step="0.01" placeholder="Optional"></label>
            </div>
            <div class="strategy-input-grid">
              <label class="profile-field" for="emd-amount">EMD amount · ₹<input id="emd-amount" name="emd_amount_inr"
                  type="number" min="0" step="1" required placeholder="0"></label>
              <label class="profile-field" for="min-local-content">Minimum local content · %<input
                  id="min-local-content" name="min_local_content_percentage" type="number" min="0" max="100" step="0.1"
                  required value="20"></label>
            </div>
            <label class="profile-field" for="required-certifications">Required certifications
              <small>Comma-separated</small><input id="required-certifications" name="mandatory_certifications"
                maxlength="500" placeholder="For example: ISO-9001, BIS"></label>
            <div class="strategy-checkbox-list">
              <label class="strategy-check"><input name="oem_authorization_mandatory" type="checkbox"><span>Tender
                  requires OEM authorization (MAF)</span></label>
              <label class="strategy-check"><input name="emd_exemption_confirmed_by_tender"
                  type="checkbox"><span>Official tender text confirms an EMD exemption</span></label>
              <label class="strategy-check"><input name="msme_turnover_relaxation_allowed" type="checkbox"
                  checked><span>Official tender text confirms turnover relief applies</span></label>
              <label class="strategy-check"><input name="is_turnover_exemption_revoked_by_atc"
                  type="checkbox"><span>Buyer ATC / Corrigendum says turnover relief does NOT apply</span></label>
              <label class="strategy-check"><input name="msme_experience_relaxation_allowed" type="checkbox"
                  checked><span>Official tender text confirms experience relief applies</span></label>
              <label class="strategy-check"><input name="is_experience_exemption_revoked_by_atc"
                  type="checkbox"><span>Buyer ATC / Corrigendum says experience relief does NOT apply</span></label>
              <label class="strategy-check"><input name="proprietary_brand_lock_detected" type="checkbox"><span>Tender
                  names a proprietary brand or model without “or equivalent”</span></label>
            </div>
            <label class="profile-field" for="brand-details">Exact clause excerpt <small>Optional</small><textarea
                id="brand-details" name="proprietary_brand_details" rows="3" maxlength="600"
                placeholder="Paste a short clause excerpt if a brand lock or restrictive condition is present"></textarea></label>
          </fieldset>

          <fieldset class="strategy-fieldset">
            <legend><span>04</span> Optional EMD &amp; Working Capital Optimizer</legend>
            <p class="strategy-field-help">Purpose: Evaluates working capital locked in bid security across concurrent tenders. Estimates liquidity unlocked by switching from cash Fixed Deposits to GFR Rule 170(i) MSME exemptions or IRDAI Insurance Surety Bonds.</p>
            <div class="strategy-input-grid strategy-input-grid-three">
              <label class="profile-field" for="lockup-days">Lock-up period · days<input id="lockup-days"
                  name="estimated_emd_lockup_days" type="number" min="1" max="3650" step="1" placeholder="120"></label>
              <label class="profile-field" for="cost-rate">Annual capital cost · %<input id="cost-rate"
                  name="annual_capital_cost_rate_pct" type="number" min="0" max="100" step="0.1"
                  placeholder="12.0"></label>
              <label class="profile-field" for="active-bids">Concurrent bids<input id="active-bids"
                  name="active_simultaneous_bids_count" type="number" min="1" max="100" step="1" value="3"></label>
            </div>
            <div class="strategy-input-grid">
              <label class="profile-field" for="working-capital">EMD working capital budget · ₹
                <small>Optional</small><input id="working-capital" name="available_emd_working_capital_inr"
                  type="number" min="0" step="1" placeholder="2500000"></label>
              <label class="profile-field" for="surety-permitted">Tender permits Insurance Surety Bond<select
                  id="surety-permitted" name="surety_bond_permitted_by_tender">
                  <option value="true">Yes (MoF OM F.1/1/2022-PPD)</option>
                  <option value="">Not checked</option>
                  <option value="false">No (FDR / e-BG only)</option>
                </select></label>
            </div>
