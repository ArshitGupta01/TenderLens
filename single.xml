  .menu-toggle { display: inline-flex; align-items: center; gap: 10px; padding: 10px 0 10px 10px; border: 0; color: var(--ink); background: transparent; font-size: 14px; font-weight: 700; cursor: pointer; }
  .menu-lines { display: flex; flex-direction: column; gap: 4px; width: 17px; }
