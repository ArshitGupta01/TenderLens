/* Password Recovery Mode (Focused single card, hidden story column) */
html.is-recovery-mode .auth-story,
body.is-recovery-mode .auth-story,
.auth-layout.is-recovery-mode .auth-story {
  display: none !important;
}

html.is-recovery-mode .auth-layout,
body.is-recovery-mode .auth-layout,
.auth-layout.is-recovery-mode {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: min(480px, 100%) !important;
  margin-inline: auto !important;
}

html.is-recovery-mode .auth-card,
body.is-recovery-mode .auth-card,
.auth-layout.is-recovery-mode .auth-card {
  width: 100% !important;
  max-width: 480px !important;
}

html.is-recovery-mode [data-signin-form],
body.is-recovery-mode [data-signin-form] {
  display: none !important;
}

html.is-recovery-mode [data-password-recovery],
body.is-recovery-mode [data-password-recovery] {
  display: block !important;
}

html.is-recovery-mode [data-signin-switch],
body.is-recovery-mode [data-signin-switch] {
  display: none !important;
}

html.is-recovery-mode [data-recovery-footer],
