.preset-btn:hover {
  border-color: var(--green) !important;
  color: var(--green) !important;
  background: var(--green-pale) !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 3px 10px rgba(16, 185, 129, 0.15) !important;
}

.preset-btn:active {
