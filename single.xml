.hero-index { display: flex; gap: 14px; align-items: center; margin-top: 45px; color: var(--muted); font: 9px var(--mono); letter-spacing: .08em; }
.hero-index span:first-child { color: var(--coral); }

.hero-demo { min-width: 0; }
.demo-caption { display: flex; justify-content: space-between; align-items: center; margin: 0 2px 10px; color: var(--muted); font: 9px var(--mono); letter-spacing: .1em; }
.sample-label { display: inline-flex; align-items: center; gap: 7px; color: var(--gold); }
.sample-label i { display: inline-block; width: 6px; height: 6px; background: #d2a844; border-radius: 50%; }
.report-window { border: 1px solid #cdd4ca; background: var(--surface); box-shadow: 0 15px 45px rgba(24, 51, 47, .09); }
.report-topbar { display: flex; justify-content: space-between; align-items: center; height: 45px; padding: 0 20px; color: #eef1e6; background: var(--ink); }
.report-brand { display: inline-flex; align-items: center; gap: 8px; font-size: 10px; font-weight: 600; letter-spacing: -.02em; }
.report-brand small { color: #afc2b7; font: 8px var(--mono); letter-spacing: .05em; }
.mini-mark { display: inline-grid; place-items: center; width: 19px; height: 19px; border: 1px solid #71978a; color: #d8b36d; font: 8px var(--mono); }
.report-id { color: #b4c8be; font: 8px var(--mono); letter-spacing: .11em; }
.report-heading { padding: 18px 22px 16px; }
