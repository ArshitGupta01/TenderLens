/* --- ENHANCED SAAS AUTH EXPERIENCE --- */
.auth-main {
  position: relative;
  display: grid;
  min-height: calc(100vh - 120px);
  place-items: center;
  padding: 48px 24px;
  overflow: hidden;
  background: radial-gradient(circle at 10% 20%, rgba(23, 111, 97, 0.08) 0%, transparent 40%),
              radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.07) 0%, transparent 40%),
              var(--paper);
}

.auth-layout {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(380px, 480px);
  align-items: center;
  gap: clamp(40px, 6vw, 96px);
  width: min(1140px, 100%);
