.principle-mark svg { width: 100%; height: 100%; }

.audience-section { padding: 110px 0 112px; }
.audience-grid { display: grid; grid-template-columns: minmax(320px, .86fr) minmax(480px, 1.14fr); gap: clamp(50px, 8vw, 124px); align-items: center; }
