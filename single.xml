          <div class="strategy-rag-dag-nodes" data-rag-dag-nodes></div>
          <details class="strategy-draft-details" open>
            <summary>Precedence Audit Trail &amp; Supersession Edges</summary>
            <ul class="strategy-rich-list" data-rag-audit-trail></ul>
          </details>
        </div>
      </div>
    </section>
