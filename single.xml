.hero-ruler { display: flex; justify-content: space-between; width: min(var(--container), calc(100% - 96px)); margin: 34px auto 0; padding-top: 12px; border-top: 1px solid var(--line); color: #84928a; font: 8px var(--mono); letter-spacing: .1em; }

.intro-section { padding: 110px 0 105px; background: #fbfaf4; }
