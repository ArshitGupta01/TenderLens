:root[data-theme="dark"] .profile-section,
:root[data-theme="dark"] .intro-section,
:root[data-theme="dark"] .principles-section,
:root[data-theme="dark"] .guide-section-muted { background: var(--paper-deep); }
:root[data-theme="dark"] .precedence-section,
:root[data-theme="dark"] .legal-main,
:root[data-theme="dark"] .not-found,
:root[data-theme="dark"] .tenderlens-curtain,
:root[data-theme="dark"] .hero,
