  margin: 0;
  font-size: 0.71875rem;
  color: #cbd5e1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.portal-badges {
  display: flex;
  gap: 6px;
  margin-top: 4px;
}

.portal-badge {
  font-size: 0.625rem;
  font-weight: 600;
  background: rgba(16, 185, 129, 0.15);
  color: #6ee7b7;
  border: 1px solid rgba(16, 185, 129, 0.3);
  padding: 2px 6px;
  border-radius: 4px;
}

.doc-tools {
  display: flex;
  gap: 6px;
  margin-bottom: 4px;
}

.tool-tag {
  font-size: 0.6875rem;
  background: rgba(255, 255, 255, 0.08);
  color: #e2e8f0;
  padding: 2px 6px;
  border-radius: 4px;
}

.pipeline-connector {
  font-size: 1.125rem;
  color: #38bdf8;
  opacity: 0.7;
  text-align: center;
  user-select: none;
}

/* Row 2: Step 4 & Step 5 */
.intelligent-pipeline-bottom {
  display: grid;
  grid-template-columns: 1.4fr auto 1fr;
  gap: 8px;
  align-items: center;
  margin-bottom: 20px;
}

.verification-subgrid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 12px;
  margin-top: 4px;
}

.deterministic-gates-box h5,
.precedence-dag-box h5 {
  font-size: 0.78125rem;
  color: #38bdf8;
  margin: 0 0 6px;
  font-weight: 600;
}

.gates-checklist {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 0.71875rem;
  color: #cbd5e1;
}

.green-check {
  color: #10b981;
