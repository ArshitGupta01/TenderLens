.scroll-progress { position: fixed; z-index: 101; top: 0; left: 0; width: 100%; height: 3px; pointer-events: none; }
.site-header { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

.opportunity-section { padding: 100px 0 108px; background: #eeeee5; }
.section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .55fr); align-items: end; gap: 60px; margin-bottom: 33px; }
.section-heading .eyebrow { margin-bottom: 18px; }
.section-heading h2, .precedence-intro h2, .profile-copy h2 { max-width: 750px; margin: 0; font: 400 clamp(42px, 5vw, 66px)/1.02 var(--serif); letter-spacing: -.05em; }
.section-heading h2 em, .precedence-intro h2 em, .profile-copy h2 em { color: var(--green); font-weight: 400; }
.section-heading > p { max-width: 390px; margin: 0 0 4px; color: var(--muted); font-size: 12px; line-height: 1.8; }
.sample-notice { display: flex; align-items: center; gap: 9px; min-height: 43px; padding: 9px 13px; border: 1px solid #d8d4c5; color: #736c57; background: rgba(255, 254, 250, .62); font-size: 9px; }
.sample-notice strong { color: var(--ink); font-weight: 700; }
.notice-dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #c19747; }
.sample-saved { display: inline-flex; align-items: center; gap: 7px; margin-left: auto; color: #879188; font: 8px var(--mono); letter-spacing: .08em; }
.sample-saved strong { display: inline-grid; min-width: 19px; height: 19px; place-items: center; border-radius: 50%; color: var(--green-dark); background: var(--green-pale); font-size: 9px; }
.explorer-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: 23px 0 18px; }
.search-field { display: flex; align-items: center; gap: 9px; width: min(100%, 370px); height: 44px; padding: 0 12px; border: 1px solid var(--line-strong); background: var(--surface); }
.search-icon { color: var(--green); font-size: 22px; line-height: 1; }
.search-field input { width: 100%; min-width: 0; border: 0; outline: 0; color: var(--ink); background: transparent; font: 10px var(--sans); }
.search-field input::placeholder { color: #93a098; }
.search-field:focus-within { border-color: var(--green); box-shadow: 0 0 0 3px rgba(23, 111, 97, .1); }
.search-field kbd { padding: 2px 5px; border: 1px solid var(--line); color: #8d9992; background: #f8f7f1; font: 8px var(--mono); }
.filter-group { display: flex; flex-wrap: wrap; gap: 6px; }
.filter-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 0 11px; border: 1px solid transparent; color: var(--muted); background: transparent; font-size: 9px; font-weight: 600; cursor: pointer; transition: .2s ease; }
.filter-chip:hover { border-color: var(--line-strong); color: var(--ink); }
.filter-chip.is-active { border-color: var(--green-dark); color: var(--surface); background: var(--green-dark); }
.filter-chip span { color: #e6bb7c; font: 8px var(--mono); }
.result-count { flex: 0 0 auto; color: #87938a; font: 8px var(--mono); letter-spacing: .04em; }
.tender-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
.tender-card { position: relative; display: flex; min-height: 286px; flex-direction: column; padding: 20px; border: 1px solid #d5d9d0; background: var(--surface); box-shadow: 0 6px 20px rgba(24, 51, 47, .025); transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
.tender-card:hover { transform: translateY(-4px); border-color: #9eb5a6; box-shadow: 0 18px 35px rgba(24, 51, 47, .08); }
.tender-card[hidden] { display: none; }
.tender-card-top { display: flex; align-items: center; justify-content: space-between; }
.portal-tag, .tender-category, .dialog-label { font: 8px var(--mono); letter-spacing: .09em; }
.portal-tag { padding: 6px 8px; color: var(--green); background: var(--green-pale); }
.save-tender { display: inline-grid; width: 31px; height: 31px; place-items: center; border: 1px solid var(--line); color: #8b9a91; background: transparent; font-size: 18px; cursor: pointer; transition: color .2s ease, background-color .2s ease, border-color .2s ease; }
.save-tender:hover, .save-tender[aria-pressed="true"] { border-color: #d7b56d; color: #9a702c; background: #f8f1de; }
.tender-category { margin: 20px 0 7px; color: var(--coral); font-size: 7px; }
.tender-card h3 { max-width: 270px; margin: 0; font: 500 24px/1.1 var(--serif); letter-spacing: -.02em; }
.tender-buyer { margin: 9px 0 18px; color: var(--muted); font-size: 9px; }
