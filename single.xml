.button-light { color: var(--ink); background: #f0ead9; }
.button-light:hover { background: white; }
.closing-note { display: block; margin-top: 44px; color: #a4bdb2; font: 8px var(--mono); letter-spacing: .12em; }

.site-footer { padding: 29px 0 18px; background: #ebe9df; }
.footer-main { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding-bottom: 24px; border-bottom: 1px solid #d5d8cf; }
.footer-brand { min-width: 0; }
.footer-main > p { margin: 0; color: var(--muted); font-size: 9px; line-height: 1.7; }
.footer-links { display: flex; gap: 21px; }
.footer-links a { color: var(--ink-soft); font-size: 9px; font-weight: 600; }
.footer-links a:hover { color: var(--coral); }
.footer-bottom { display: flex; justify-content: space-between; padding-top: 15px; color: #86938b; font: 7px var(--mono); letter-spacing: .09em; }

.legal-page { min-height: 100vh; background: var(--paper); }
