<file path="frontend/styles.css">
:root {
  color-scheme: light;
  --paper: #f4f2e9;
  --paper-deep: #eae8de;
  --surface: #fffefa;
  --ink: #18332f;
  --ink-soft: #38544e;
  --muted: #6d7e77;
  --line: #d8ddd3;
  --line-strong: #bdc9bf;
  --green: #176f61;
  --green-dark: #17453d;
  --green-pale: #e4eee4;
  --coral: #cb5b3d;
  --coral-pale: #f7e8df;
  --gold: #a67829;
  --gold-pale: #f3eddc;
  --mono: 'DM Mono', 'Consolas', monospace;
  --sans: 'DM Sans', 'Segoe UI', Arial, sans-serif;
  --serif: 'Newsreader', 'Iowan Old Style', Georgia, serif;
  --container: 1280px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 96px; }
body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }
button:focus-visible, a:focus-visible { outline: 3px solid #bf6a4a; outline-offset: 4px; }
::selection { color: var(--surface); background: var(--green); }
.container { width: min(var(--container), calc(100% - 96px)); margin-inline: auto; }
.section-rule { border-bottom: 1px solid var(--line); }
.skip-link { position: fixed; z-index: 100; top: 10px; left: 10px; padding: 10px 14px; color: white; background: var(--ink); transform: translateY(-160%); }
.skip-link:focus { transform: translateY(0); }

/* ==========================================================================
   TenderLens - Floating Corner Controls & Slide-over Navigation Drawer
   ========================================================================== */
.floating-corner-controls {
  pointer-events: none;
}

.floating-menu-btn {
  position: fixed;
  top: 20px;
  left: 24px;
  z-index: 100;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  height: 44px;
  padding: 0 18px 0 14px;
  border-radius: 999px;
  background: rgba(255, 254, 250, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(24, 51, 47, 0.16);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 600;
  box-shadow: 0 4px 20px rgba(24, 51, 47, 0.09);
  cursor: pointer;
  pointer-events: auto;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.floating-menu-btn:hover {
  transform: translateY(-2px);
  background: #ffffff;
  border-color: var(--green);
  box-shadow: 0 8px 25px rgba(24, 51, 47, 0.16);
}

.floating-menu-icon {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
  width: 16px;
  height: 14px;
}

.floating-menu-icon span {
  display: block;
  width: 100%;
  height: 2px;
  background: var(--ink);
  border-radius: 2px;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.floating-cta-btn {
  position: fixed;
  top: 20px;
  right: 24px;
  z-index: 100;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 44px;
  padding: 0 20px;
  border-radius: 999px;
  background: var(--green-dark);
  color: #ffffff !important;
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 700;
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 4px 20px rgba(23, 69, 61, 0.25);
  text-decoration: none;
  cursor: pointer;
  pointer-events: auto;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.floating-cta-btn:hover {
  transform: translateY(-2px);
  background: var(--green);
  box-shadow: 0 8px 28px rgba(23, 111, 97, 0.35);
  color: #ffffff !important;
}

.floating-cta-btn span[aria-hidden="true"] {
  font-size: 14px;
  transition: transform 0.18s ease;
}

.floating-cta-btn:hover span[aria-hidden="true"] {
  transform: translate(2px, -2px);
}

/* Floating Navigation Drawer */
.floating-nav-drawer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: visibility 0.28s ease, opacity 0.28s ease;
}

.floating-nav-drawer.is-open {
  visibility: visible;
  opacity: 1;
}

.drawer-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 34, 30, 0.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.drawer-panel {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: min(380px, 86vw);
  background: var(--paper);
  box-shadow: 12px 0 40px rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  padding: 24px 28px;
  transform: translateX(-100%);
  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  overflow-y: auto;
}

.floating-nav-drawer.is-open .drawer-panel {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
}

.drawer-close-btn {
  display: inline-grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--ink);
  cursor: pointer;
  transition: all 0.18s ease;
}

.drawer-close-btn:hover {
  background: var(--paper-deep);
  transform: rotate(90deg);
}

.drawer-actions-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 20px 0 24px;
}

.drawer-actions-row .header-account-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38px;
  padding: 0 16px;
  border-radius: 999px;
  border: 1px solid var(--line-strong);
  background: var(--surface);
  color: var(--ink);
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.18s ease;
}

.drawer-actions-row .header-account-link:hover {
  border-color: var(--green);
  color: var(--green);
}

.drawer-actions-row .theme-toggle {
  height: 38px;
  padding: 0 14px;
  border-radius: 999px;
  border: 1px solid var(--line-strong);
  background: var(--surface);
  color: var(--ink);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.18s ease;
}

.drawer-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.drawer-nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-radius: 8px;
  color: var(--ink);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.18s ease;
}

.drawer-nav-item:hover {
  background: var(--paper-deep);
  color: var(--green);
  padding-left: 18px;
}

.drawer-nav-highlight {
  margin-top: 14px;
  background: var(--ink);
  color: var(--surface) !important;
  font-size: 14px;
}

.drawer-nav-highlight:hover {
  background: var(--green);
  color: var(--surface) !important;
  padding-left: 14px;
}

.drawer-nav-highlight span {
  font-size: 16px;
  color: #dfa26e;
}

/* Dark mode overrides for floating controls */
:root[data-theme="dark"] .floating-menu-btn {
  background: rgba(17, 26, 23, 0.92);
  border-color: rgba(130, 210, 184, 0.25);
  color: #f7fbf8;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

:root[data-theme="dark"] .floating-menu-icon span {
  background: #f7fbf8;
}

:root[data-theme="dark"] .floating-cta-btn {
  background: var(--green);
  color: #111a17 !important;
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 0 4px 20px rgba(130, 210, 184, 0.35);
}

:root[data-theme="dark"] .floating-cta-btn:hover {
  background: #9be0cb;
  box-shadow: 0 8px 28px rgba(130, 210, 184, 0.45);
}

:root[data-theme="dark"] .drawer-panel {
  background: var(--paper);
  box-shadow: 12px 0 40px rgba(0, 0, 0, 0.6);
}

:root[data-theme="dark"] .drawer-close-btn {
  background: var(--paper-deep);
  border-color: var(--line);
  color: var(--ink);
}

:root[data-theme="dark"] .drawer-actions-row .header-account-link,
:root[data-theme="dark"] .drawer-actions-row .theme-toggle {
  background: var(--paper-deep);
  border-color: var(--line);
  color: var(--ink);
}

:root[data-theme="dark"] .drawer-nav-highlight {
  background: var(--green-dark);
  color: #f7fbf8 !important;
}

/* Completely remove old header and ribbons */
.site-header {
  display: none !important;
}
.top-ribbon-overlay {
  display: none !important;
}

/* Layout padding adjustment for floating controls */
.hero {
  padding-top: 86px !important;
}
.guide-hero, .account-hero, .saved-hero, .not-found {
  padding-top: 86px !important;
}
.auth-main {
  padding-top: 86px !important;
}

.hero { position: relative; padding: 65px 0 52px; overflow: hidden; }
.hero-grid { display: grid; grid-template-columns: minmax(350px, .78fr) minmax(530px, 1.22fr); align-items: center; gap: clamp(42px, 6.8vw, 104px); }
.hero-copy { padding: 12px 0 6px; }
.eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 22px; color: var(--green); font: 10px var(--mono); letter-spacing: .09em; text-transform: uppercase; }
.eyebrow-mark { display: inline-block; width: 18px; height: 1px; background: var(--coral); }
h1, h2, h3, p { margin-top: 0; }
.hero h1 { max-width: 650px; margin: 0; font: 400 clamp(56px, 6.3vw, 88px)/.96 var(--serif); letter-spacing: -.065em; }
.hero h1 em, h2 em { color: var(--green); font-weight: 400; }
.hero-lede { max-width: 470px; margin: 25px 0 0; color: var(--ink-soft); font-size: 15px; line-height: 1.78; }
.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 26px; margin: 28px 0 0; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 22px; min-height: 48px; padding: 0 17px; font-size: 11px; font-weight: 700; transition: background-color .2s ease, transform .2s ease; }
.button:hover { transform: translateY(-2px); }
.button span { font-size: 16px; font-weight: 400; transition: transform .18s ease; }
.button:hover span { transform: translate(2px, -2px); }
.button-dark { color: var(--surface); background: var(--ink); }
.button-dark:hover { background: var(--green); }
.text-link { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 11px; font-weight: 700; border-bottom: 1px solid var(--line-strong); padding-bottom: 4px; transition: color .18s ease, border-color .18s ease; }
.text-link:hover { color: var(--coral); border-color: var(--coral); }
.text-link span { color: var(--coral); font-size: 15px; }
.hero-proof { display: flex; align-items: center; gap: 12px; margin-top: 32px; }
.proof-seal { display: inline-flex; width: 34px; height: 34px; color: var(--green); }
