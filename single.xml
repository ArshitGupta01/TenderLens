.account-welcome > div > p, .saved-heading > div > p { margin: 13px 0 0; color: var(--ink-soft); font-size: 17px; }
.account-email-row { display: flex; align-items: center; gap: 12px; max-width: 590px; margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--line-strong); }
