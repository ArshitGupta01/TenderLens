.audience-focus span { color: #8d9b91; font: 7px var(--mono); letter-spacing: .09em; }
.audience-focus strong { color: var(--green); font-size: 9px; font-weight: 600; }

.closing-section { padding: 97px 0 91px; color: #f4f2e9; background: var(--green-dark); }
.closing-inner { position: relative; text-align: center; }
.closing-stamp { position: absolute; top: -16px; right: max(0px, 7%); display: grid; place-items: center; width: 71px; height: 71px; border: 1px solid #4b7468; transform: translate3d(0, var(--parallax-offset, 0), 0) rotate(8deg); will-change: transform; }
.closing-stamp span { color: #ddaa6d; font: 20px var(--serif); }
.closing-stamp i { position: absolute; right: 5px; bottom: 5px; width: 5px; height: 5px; background: var(--coral); border-radius: 50%; }
.closing-section .eyebrow { justify-content: center; color: #a6c4b5; }
