.dialog-fact small { margin-bottom: 5px; color: #8b9990; font: 7px var(--mono); letter-spacing: .08em; }
.dialog-fact strong { font-size: 11px; font-weight: 600; }
.dialog-focus { margin-top: 22px; }
.dialog-focus > span { color: #8b9990; font: 8px var(--mono); letter-spacing: .09em; }
.dialog-focus ul { display: grid; gap: 7px; margin: 10px 0 0; padding: 0; list-style: none; }
.dialog-focus li { display: flex; align-items: flex-start; gap: 9px; color: var(--ink-soft); font-size: 10px; }
.dialog-focus li::before { content: '↗'; color: var(--coral); }
.dialog-disclaimer { margin: 20px 0 17px; padding-left: 10px; border-left: 2px solid #d0ad5e; color: var(--muted); font-size: 9px; line-height: 1.65; }
.dialog-content .button { min-height: 42px; font-size: 9px; }

.precedence-section { padding: 108px 0; background: #f9f8f1; }
.precedence-grid { display: grid; grid-template-columns: minmax(280px, .72fr) minmax(530px, 1.28fr); align-items: center; gap: clamp(45px, 8vw, 118px); }
.precedence-intro .eyebrow, .profile-copy .eyebrow { margin-bottom: 18px; }
.precedence-intro h2, .profile-copy h2 { font-size: clamp(42px, 4.8vw, 62px); }
.precedence-intro > p:not(.eyebrow), .profile-copy > p:not(.eyebrow) { max-width: 390px; margin: 20px 0; color: var(--muted); font-size: 11px; line-height: 1.8; }
.precedence-caveat { display: inline-flex; padding: 7px 9px; border: 1px solid #dfd3b3; color: #8a733e; background: #f6f0df; font: 7px var(--mono); letter-spacing: .08em; }
.precedence-explorer { display: grid; grid-template-columns: minmax(225px, .88fr) minmax(250px, 1.12fr); border: 1px solid var(--line-strong); background: var(--surface); box-shadow: 0 15px 40px rgba(24, 51, 47, .06); }
.precedence-stack { padding: 12px; border-right: 1px solid var(--line); background: #f7f6ef; }
.precedence-layer { display: grid; width: 100%; grid-template-columns: 31px minmax(0, 1fr) 14px; align-items: center; gap: 8px; min-height: 58px; padding: 8px; border: 1px solid transparent; color: var(--ink); background: transparent; text-align: left; cursor: pointer; transition: background-color .18s ease, border-color .18s ease; }
.precedence-layer:hover { border-color: var(--line); background: rgba(255, 254, 250, .8); }
.precedence-layer.is-active { border-color: #b9cabe; background: var(--surface); box-shadow: 0 5px 14px rgba(24, 51, 47, .05); }
.layer-rank { display: grid; width: 27px; height: 27px; place-items: center; color: #909d94; background: #ebece4; font: 9px var(--mono); }
.precedence-layer.is-active .layer-rank { color: #fff; background: var(--green); }
.layer-name { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.layer-name strong { overflow: hidden; font-size: 9px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.layer-name small { color: var(--muted); font-size: 7px; }
.layer-arrow { color: #a4b0a7; font-size: 12px; }
.precedence-layer.is-active .layer-arrow { color: var(--coral); }
.precedence-detail { display: flex; flex-direction: column; justify-content: center; min-height: 337px; padding: 25px; }
.precedence-detail-top { display: flex; justify-content: space-between; align-items: center; color: var(--coral); font: 8px var(--mono); letter-spacing: .09em; }
.precedence-mark { display: grid; width: 31px; height: 31px; place-items: center; border: 1px solid #e6d7c8; color: var(--gold); font-size: 14px; }
.precedence-detail h3 { max-width: 300px; margin: 19px 0 9px; font: 500 30px/1.08 var(--serif); letter-spacing: -.03em; }
.precedence-detail > p { min-height: 68px; margin: 0; color: var(--ink-soft); font-size: 10px; line-height: 1.75; }
.precedence-rule { margin-top: 19px; padding: 12px; border-left: 2px solid var(--green); background: #eff3ed; }
.precedence-rule span { display: block; margin-bottom: 5px; color: #7d9185; font: 7px var(--mono); letter-spacing: .09em; }
.precedence-rule strong { display: block; color: var(--green-dark); font-size: 9px; font-weight: 600; line-height: 1.6; }

.profile-section { padding: 106px 0; background: #eeeee5; }
.profile-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(45px, 8vw, 118px); }
.profile-privacy { display: flex; align-items: flex-start; gap: 11px; max-width: 360px; margin-top: 30px; padding: 13px; border: 1px solid #d3d9ce; background: rgba(255, 254, 250, .7); }
.profile-privacy > span:first-child { display: grid; width: 24px; height: 24px; flex: 0 0 24px; place-items: center; border: 1px solid #c1d1c3; border-radius: 50%; color: var(--green); font-size: 15px; }
.profile-privacy strong, .profile-privacy small { display: block; }
.profile-privacy strong { font-size: 9px; }
.profile-privacy small { margin-top: 4px; color: var(--muted); font-size: 8px; line-height: 1.55; }
.bidder-profile-form { display: grid; gap: 13px; margin-top: 17px; padding: 18px; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 8px 24px rgba(24, 51, 47, .045); }
.profile-form-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 11px; border-bottom: 1px solid var(--line); }
.profile-form-heading .micro-label { margin: 0; color: var(--muted); font: 11px var(--mono); letter-spacing: .08em; }
.profile-storage-label { padding: 4px 7px; border: 1px solid var(--line); color: var(--green); font: 10px var(--mono); letter-spacing: .05em; }
.profile-form-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
.profile-field { display: grid; gap: 6px; color: var(--ink-soft); font-size: 13px; font-weight: 600; }
.profile-field input, .profile-field select { width: 100%; min-height: 46px; padding: 0 11px; border: 1px solid var(--line-strong); border-radius: 2px; color: var(--ink); background: var(--paper); font: 15px var(--sans); }
.profile-field input::placeholder { color: var(--muted); }
.profile-field input:focus-visible, .profile-field select:focus-visible { outline: 3px solid rgba(23, 111, 97, .26); outline-offset: 2px; }
.profile-form-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
.profile-form-actions .button { min-height: 44px; justify-content: space-between; }
.profile-clear { min-height: 44px; padding: 0 10px; border: 1px solid var(--line-strong); color: var(--ink-soft); background: transparent; font-size: 14px; font-weight: 600; cursor: pointer; }
.profile-clear:hover { border-color: var(--coral); color: var(--coral); }
.profile-save-status { min-height: 21px; margin: -2px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
.profile-save-status[data-state="success"] { color: var(--green); }
.profile-save-status[data-state="error"] { color: var(--coral); }
.readiness-card { border: 1px solid #d0d8cf; background: var(--surface); box-shadow: 0 16px 42px rgba(24, 51, 47, .07); }
.readiness-top { display: flex; justify-content: space-between; padding: 13px 18px; border-bottom: 1px solid var(--line); color: #8b9990; font: 8px var(--mono); letter-spacing: .09em; }
.readiness-top span:last-child { color: var(--green); }
.readiness-summary { display: flex; align-items: center; justify-content: space-between; padding: 20px 20px 14px; }
.readiness-summary .micro-label { display: block; font-size: 7px; }
.readiness-summary h3 { margin: 5px 0 0; color: var(--ink); font: 500 35px/1 var(--serif); }
.readiness-summary h3 small { color: #9aa69d; font: 400 17px var(--sans); }
.readiness-badge { padding: 6px 9px; color: #927139; background: #f4efdf; font: 7px var(--mono); letter-spacing: .07em; }
.readiness-badge.is-complete { color: var(--green); background: var(--green-pale); }
.progress-label { display: flex; justify-content: space-between; padding: 0 20px; color: var(--muted); font-size: 8px; }
.progress-label span:last-child { color: var(--green); font: 8px var(--mono); }
.readiness-card progress { display: block; width: calc(100% - 40px); height: 5px; margin: 8px 20px 16px; border: 0; border-radius: 0; appearance: none; }
.readiness-card progress::-webkit-progress-bar { background: #e8ece5; }
.readiness-card progress::-webkit-progress-value { background: var(--green); transition: width .25s ease; }
.readiness-card progress::-moz-progress-bar { background: var(--green); }
.profile-checklist { display: grid; gap: 0; margin: 0 20px; padding: 0; border: 0; }
.profile-check { position: relative; display: grid; grid-template-columns: 19px minmax(0,1fr) auto; align-items: center; gap: 10px; min-height: 54px; border-bottom: 1px solid #edf0eb; cursor: pointer; }
.profile-check:last-child { border-bottom: 0; }
.profile-check input { position: absolute; width: 19px; height: 19px; margin: 0; opacity: 0; cursor: pointer; }
.custom-check { display: grid; width: 19px; height: 19px; place-items: center; border: 1px solid #c5d0c7; color: transparent; background: #fff; font-size: 11px; transition: color .18s ease, background-color .18s ease, border-color .18s ease; }
.profile-check input:checked + .custom-check { border-color: var(--green); color: white; background: var(--green); }
.profile-check input:focus-visible + .custom-check { outline: 3px solid #bf6a4a; outline-offset: 3px; }
.profile-check > span:nth-of-type(2) { display: flex; flex-direction: column; gap: 2px; }
.profile-check strong { color: var(--ink); font-size: 9px; font-weight: 600; }
.profile-check small { color: var(--muted); font-size: 7px; }
.check-state { color: #9a8770; font: 7px var(--mono); letter-spacing: .05em; }
.profile-check.is-checked .check-state { color: var(--green); }
.readiness-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 65px; margin-top: 7px; padding: 12px 20px; border-top: 1px solid var(--line); background: #f8f7f1; }
.readiness-footer p { max-width: 345px; margin: 0; color: var(--muted); font-size: 8px; line-height: 1.6; }
.reset-profile { flex: 0 0 auto; padding: 7px 9px; border: 1px solid var(--line-strong); color: var(--ink-soft); background: transparent; font-size: 8px; font-weight: 600; cursor: pointer; }
.reset-profile:hover { border-color: var(--green); color: var(--green); }

.back-to-top { position: fixed; z-index: 45; right: 25px; bottom: 24px; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid #45665a; color: #f8f7f0; background: var(--green-dark); box-shadow: 0 8px 24px rgba(18, 44, 38, .17); opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .2s ease, visibility .2s ease, transform .2s ease; cursor: pointer; }
.back-to-top.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
.back-to-top.is-over-footer { opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(8px); }
.back-to-top span:first-child { color: #e6b777; font-size: 15px; }
.back-to-top span:last-child { font: 8px var(--mono); letter-spacing: .07em; }
.motion-ready [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s cubic-bezier(.2,.7,.2,1); }
.motion-ready [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }

@media (max-width: 1100px) {
