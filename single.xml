<file path="styles.css">
:root {
  color-scheme: light;
  --paper: #f4f2e9;
  --paper-deep: #eae8de;
  --surface: #fffefa;
  --ink: #18332f;
  --ink-soft: #38544e;
  --muted: #6d7e77;
  --line: #d8ddd3;
  --line-strong: #bdc9bf;
  --green: #176f61;
  --green-dark: #17453d;
  --green-pale: #e4eee4;
  --coral: #cb5b3d;
  --coral-pale: #f7e8df;
  --gold: #a67829;
  --gold-pale: #f3eddc;
  --mono: 'DM Mono', 'Consolas', monospace;
