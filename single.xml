.principles-title h2 { font-size: clamp(40px, 4.4vw, 58px); }
.principles-list { border-top: 1px solid var(--line-strong); }
.principle { display: grid; grid-template-columns: 28px 1fr 28px; gap: 15px; align-items: start; padding: 23px 0; border-bottom: 1px solid var(--line); }
.principle-index { color: var(--coral); font: 9px var(--mono); }
