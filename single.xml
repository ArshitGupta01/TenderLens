/* Auth Card Container */
.auth-card {
  position: relative;
  padding: clamp(28px, 3.5vw, 40px);
  border: 1px solid var(--line-strong);
  border-radius: 20px;
  background: var(--surface);
  box-shadow: 0 24px 60px -15px rgba(15, 23, 42, 0.09), 0 0 0 1px rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(12px);
}

.auth-card-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--line);
}

.auth-brand-badge {
  display: inline-flex;
  width: 36px;
  height: 36px;
  border-radius: 9px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.16);
  flex-shrink: 0;
}

.auth-brand-badge svg {
  width: 100%;
  height: 100%;
}

.auth-brand-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
}

.auth-brand-name {
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.05em;
}

.auth-brand-name span {
  color: var(--green);
  font-weight: 500;
}

.auth-badge-pill {
  font: 9px var(--mono);
  font-weight: 700;
  color: var(--green);
  background: rgba(23, 111, 97, 0.08);
  border: 1px solid rgba(23, 111, 97, 0.2);
  padding: 3px 8px;
  border-radius: 999px;
  letter-spacing: 0.08em;
}

.auth-card-header {
  margin-bottom: 22px;
}

.auth-card-header h2 {
  margin: 0;
  font: 500 clamp(28px, 3.5vw, 36px)/1.1 var(--serif);
  letter-spacing: -0.035em;
  color: var(--ink);
}

.auth-card-header .auth-intro {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 14px;
}

/* Modern Inputs with Icons */
.auth-form {
  display: grid;
  gap: 16px;
}

.auth-form .profile-field {
  display: grid;
  gap: 7px;
  color: var(--ink-soft);
  font-size: 13px;
  font-weight: 600;
}

.auth-field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.auth-text-link {
  font-size: 12px;
  color: var(--green);
  font-weight: 600;
  text-decoration: none;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  transition: color 0.15s ease;
}

.auth-text-link:hover {
  text-decoration: underline;
  color: #3b82f6;
}

.auth-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.auth-input-icon {
  position: absolute;
  left: 14px;
  color: var(--muted);
  font-size: 14px;
  pointer-events: none;
  user-select: none;
  z-index: 1;
}

.auth-input-wrapper input {
  width: 100%;
  min-height: 48px;
  padding: 0 42px 0 40px;
  border: 1.5px solid var(--line-strong);
  border-radius: 10px;
  color: var(--ink);
  background: var(--paper);
  font: 14.5px var(--sans);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.auth-input-wrapper input::placeholder {
  color: color-mix(in srgb, var(--muted) 70%, transparent);
  font-size: 13.5px;
}

.auth-input-wrapper input:focus {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3.5px rgba(59, 130, 246, 0.18);
  background: var(--surface);
  outline: none;
}

.auth-password-toggle {
  position: absolute;
  right: 10px;
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 14px;
  transition: all 0.15s ease;
}

.auth-password-toggle:hover {
  color: var(--ink);
  background: rgba(0, 0, 0, 0.05);
}

.auth-input-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

@media (max-width: 540px) {
  .auth-input-grid {
    grid-template-columns: 1fr;
  }
}

/* Password Strength Meter */
.password-meter-wrap {
  display: grid;
  gap: 6px;
  margin: -4px 0 4px;
}

.password-meter-bars {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  height: 4px;
}

.meter-bar {
  height: 100%;
  border-radius: 2px;
  background: var(--line);
  transition: background 0.25s ease;
}

.meter-bar.is-active.is-weak { background: #ef4444; }
.meter-bar.is-active.is-medium { background: #f59e0b; }
.meter-bar.is-active.is-strong { background: #10b981; }

.password-meter-label {
  font-size: 11px;
  color: var(--muted);
  font-family: var(--mono);
}

.password-meter-label.text-weak { color: #ef4444; }
.password-meter-label.text-medium { color: #f59e0b; }
.password-meter-label.text-strong { color: #10b981; }

/* Enhanced Submit Button */
.auth-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  min-height: 48px;
  border: 0;
  border-radius: 10px;
  background: linear-gradient(135deg, #176f61 0%, #114a41 100%);
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 14px rgba(23, 111, 97, 0.28);
  margin-top: 6px;
}

.auth-submit:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(23, 111, 97, 0.38);
  background: linear-gradient(135deg, #1b8272 0%, #14594e 100%);
}

.auth-submit:active {
  transform: translateY(0);
  box-shadow: 0 2px 8px rgba(23, 111, 97, 0.25);
}

.auth-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.auth-arrow {
  transition: transform 0.2s ease;
  font-size: 17px;
  line-height: 1;
}

.auth-submit:hover .auth-arrow {
  transform: translateX(4px);
}

/* Status message styling */
.auth-status {
  min-height: 0;
  margin: 0;
  color: var(--muted);
  font-size: 13.5px;
  line-height: 1.5;
  border-radius: 8px;
}

.auth-status:not(:empty) {
  padding: 11px 14px;
  border-left: 3px solid var(--line-strong);
  background: var(--paper);
}

.auth-status[data-state="success"] {
  border-color: #10b981;
  background: rgba(16, 185, 129, 0.08);
  color: #065f46;
}

.auth-status[data-state="error"],
.auth-status[data-state="unavailable"] {
  border-color: #ef4444;
  background: rgba(239, 68, 68, 0.08);
  color: #991b1b;
}

.auth-status[data-state="loading"] {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.08);
  color: #92400e;
}

/* Footer / Switch */
.auth-card-footer {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
  text-align: center;
}

.auth-switch {
  margin: 0;
  font-size: 13.5px;
  color: var(--muted);
}

.auth-switch a, .auth-terms a, .auth-config-hint a {
  color: var(--green);
  font-weight: 700;
  text-decoration: none;
  margin-left: 3px;
}

.auth-switch a:hover, .auth-terms a:hover {
  text-decoration: underline;
  color: #3b82f6;
}

.auth-terms {
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
  text-align: center;
}

.auth-config-hint {
  margin: 15px 0 0;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--ink-soft);
  background: var(--paper);
  font-size: 13px;
}

.auth-orbit {
  position: absolute;
  width: 245px;
  height: 245px;
  border: 1px solid color-mix(in srgb, var(--green) 18%, transparent);
  border-radius: 50%;
  pointer-events: none;
  animation: orbit-drift 18s ease-in-out infinite alternate;
}

.auth-orbit-one { top: 10%; left: -130px; }
.auth-orbit-two { right: -100px; bottom: 6%; width: 340px; height: 340px; animation-delay: -7s; }

.auth-footer {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  width: min(1140px, calc(100% - 48px));
  margin: 18px auto 30px;
  color: var(--muted);
  font-size: 13px;
}

.auth-footer > span { display: flex; gap: 20px; }
.auth-footer a:hover { color: var(--green); }

/* Dark mode enhancements */
:root[data-theme="dark"] .auth-main {
  background: radial-gradient(circle at 10% 20%, rgba(23, 111, 97, 0.16) 0%, transparent 40%),
              radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.12) 0%, transparent 40%),
              #080d14;
}

:root[data-theme="dark"] .auth-card {
  background: rgba(14, 22, 29, 0.92);
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.06);
}

:root[data-theme="dark"] .auth-card-brand,
:root[data-theme="dark"] .auth-card-footer {
  border-color: rgba(255, 255, 255, 0.08);
}

:root[data-theme="dark"] .auth-input-wrapper input {
  background: rgba(10, 16, 22, 0.85);
  border-color: rgba(255, 255, 255, 0.15);
  color: #f8fafc;
}

:root[data-theme="dark"] .auth-input-wrapper input:focus {
  border-color: #38bdf8;
  box-shadow: 0 0 0 3.5px rgba(56, 189, 248, 0.22);
  background: rgba(13, 20, 28, 0.95);
}

:root[data-theme="dark"] .auth-password-toggle:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

:root[data-theme="dark"] .auth-submit {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
}

:root[data-theme="dark"] .auth-submit:hover {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
}

:root[data-theme="dark"] .auth-pillar-card {
  background: rgba(17, 26, 33, 0.6);
  border-color: rgba(255, 255, 255, 0.08);
}

:root[data-theme="dark"] .auth-pillar-card:hover {
  background: rgba(22, 34, 43, 0.85);
  border-color: rgba(255, 255, 255, 0.16);
}

:root[data-theme="dark"] .auth-stats-strip {
  background: rgba(14, 22, 29, 0.8);
  border-color: rgba(255, 255, 255, 0.08);
}

:root[data-theme="dark"] .auth-stat-divider {
  background: rgba(255, 255, 255, 0.1);
}

:root[data-theme="dark"] .auth-status[data-state="success"] {
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
}

:root[data-theme="dark"] .auth-status[data-state="error"] {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
}

