.section-heading > p { max-width: 390px; margin: 0 0 4px; color: var(--muted); font-size: 12px; line-height: 1.8; }
.sample-notice { display: flex; align-items: center; gap: 9px; min-height: 43px; padding: 9px 13px; border: 1px solid #d8d4c5; color: #736c57; background: rgba(255, 254, 250, .62); font-size: 9px; }
