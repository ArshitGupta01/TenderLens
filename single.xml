/* Larger, clearer type and the optional live search */
body { font-size: 17px; line-height: 1.7; }
.brand-descriptor, .hero-index, .demo-caption, .eyebrow, .report-kicker, .micro-label, .panel-intro,
.status-text, .evidence-note, .requirement-number, .doc-state, .report-footer > span, .hero-ruler,
.section-number, .journey-index, .method-count, .method-tag, .principle-index, .audience-display-top,
.audience-display-bottom, .audience-mini, .audience-focus span, .closing-note, .footer-bottom,
.sample-saved, .portal-tag, .tender-category, .dialog-label, .tender-facts small, .dialog-fact small,
.dialog-focus > span, .precedence-caveat, .precedence-detail-top, .layer-rank, .precedence-rule span,
.readiness-top, .readiness-badge, .progress-label span:last-child, .check-state, .live-result-source {
  font-size: 12px;
  line-height: 1.45;
}
small { font-size: max(12px, 1em); line-height: 1.5; }
.primary-nav a, .button, .text-link, .menu-toggle, .theme-toggle, .print-report, .preview-tender,
