.footer-bottom { display: flex; justify-content: space-between; padding-top: 15px; color: #86938b; font: 7px var(--mono); letter-spacing: .09em; }

.legal-page { min-height: 100vh; }
.legal-main { min-height: calc(100vh - 188px); padding: 75px 0 100px; background: #fbfaf4; }
.legal-copy { max-width: 760px; }
.legal-copy h1 { margin: 0 0 20px; font: 400 clamp(48px, 6vw, 76px)/1 var(--serif); letter-spacing: -.05em; }
.legal-copy .legal-intro { max-width: 620px; margin: 0 0 45px; color: var(--ink-soft); font-size: 14px; line-height: 1.8; }
