}

.bench-output {
  margin-top: 16px;
  border-top: 1px solid rgba(56, 189, 248, 0.2);
  padding-top: 14px;
}

.bench-progress-stepper {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.bench-progress-stepper .b-step {
  font-size: 0.6875rem;
  font-weight: 600;
  padding: 4px 8px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.05);
  color: #94a3b8;
  transition: all 0.2s ease;
}

.bench-progress-stepper .b-step.active {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.4);
}

.bench-progress-stepper .b-step.done {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
}

.bench-console {
  background: #020617;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  padding: 12px;
  font-family: var(--font-mono, monospace);
  font-size: 0.75rem;
  line-height: 1.5;
  color: #cbd5e1;
  max-height: 220px;
  overflow-y: auto;
}


/* Responsive Media Queries for Architecture & Tech Stack */
@media (max-width: 960px) {
  .engine-comparison-grid {
    grid-template-columns: 1fr;
  }
  .intelligent-pipeline-stepper {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .pipeline-connector {
    transform: rotate(90deg);
  }
  .intelligent-pipeline-bottom {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .verification-subgrid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .bench-controls {
    flex-direction: column;
    align-items: stretch;
  }
  .bench-actions {
    flex-direction: column;
  }
  .flawed-hazards-grid {
    grid-template-columns: 1fr;
  }
  .layer-components {
    grid-template-columns: 1fr;
  }
}

