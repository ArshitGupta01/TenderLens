:root[data-theme="dark"] {
  color-scheme: dark;
  --paper: #111a17;
  --paper-deep: #18231f;
  --surface: #1d2b26;
  --ink: #edf4ef;
  --ink-soft: #c9d6ce;
  --muted: #a5b5ab;
  --line: #35483e;
  --line-strong: #51675a;
  --green: #82d2b8;
  --green-dark: #214b3d;
  --green-pale: #254338;
  --coral: #f0a184;
  --coral-pale: #4a3028;
  --gold: #e8c46d;
  --gold-pale: #40391f;
}
:root[data-theme="dark"] body { background: var(--paper); }
