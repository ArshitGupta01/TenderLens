                  <option>OEM</option>
                  <option>EPC</option>
                  <option>Reseller</option>
                  <option>Trader</option>
                  <option>Other</option>
                </select></label>
              <label class="profile-field" for="strategy-years">Years in business<input id="strategy-years"
