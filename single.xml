.legal-copy { max-width: 760px; }
.legal-copy h1 { margin: 0 0 20px; font: 400 clamp(48px, 6vw, 76px)/1 var(--serif); letter-spacing: -.05em; color: var(--ink); }
.legal-copy .legal-intro { max-width: 620px; margin: 0 0 45px; color: var(--ink-soft); font-size: 14px; line-height: 1.8; }
.legal-copy h2 { margin: 34px 0 8px; font: 500 24px var(--serif); color: var(--ink); }
.legal-copy p, .legal-copy li { color: var(--muted); font-size: 12px; line-height: 1.8; }
.legal-copy ul { padding-left: 20px; }
.legal-back { margin-top: 30px; }
.not-found { min-height: calc(100vh - 188px); display: grid; place-items: center; padding: 60px 0; background: var(--paper); text-align: center; }
