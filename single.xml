/* ==========================================================================
   TenderLens Dynamic Wordmark Hero & Aspect-Ratio Scaling System
   ========================================================================== */
.tenderlens-doodle-stage {
  position: relative;
  width: 100%;
  background: var(--bg-canvas, #090e17);
  box-sizing: border-box;
  overflow: hidden;
}

.tenderlens-doodle-sticky {
  width: 100%;
  box-sizing: border-box;
}

#tenderlens-doodle-root {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Ensure the Doodle Crew root renders ONLY the pure wordmark and crew */
#tenderlens-doodle-root .dcf {
  background: transparent !important;
  border-bottom: none !important;
  padding: 0 !important;
  min-height: unset !important;
  width: 100% !important;
}

/* Fluid responsive world container that scales with viewport width & aspect ratio */
#tenderlens-doodle-root .dcf-world {
  padding: clamp(8px, 2vw, 24px) clamp(12px, 3vw, 48px) !important;
  max-width: 100% !important;
  width: 100% !important;
  margin: 0 auto !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

#tenderlens-doodle-root .dcf-stage {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Fluid SVG sizing: scales dynamically with viewport width, height and aspect ratio */
#tenderlens-doodle-root .dcf-svg {
  display: block;
  width: clamp(290px, 95vw, 1780px);
  max-height: clamp(160px, 48vh, 460px);
  height: auto;
  margin: 0 auto;
  filter: drop-shadow(0 14px 40px rgba(0, 0, 0, 0.5));
  transition: width 0.2s ease, max-height 0.2s ease, transform 0.2s ease;
  user-select: none;
  -webkit-user-select: none;
}

.doodle-scroll-cue {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 10px 16px 20px;
  font-size: 0.8125rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #94a3b8;
  font-weight: 600;
  cursor: pointer;
  user-select: none;
  transition: color 0.2s ease;
  animation: doodleCueFloat 2.4s ease-in-out infinite;
}

.doodle-scroll-cue:hover {
  color: #38bdf8;
}

.doodle-scroll-cue svg {
  stroke: #38bdf8;
  transition: transform 0.2s ease;
}

.doodle-scroll-cue:hover svg {
  transform: translateY(4px);
}

@keyframes doodleCueFloat {
  0%, 100% {
    transform: translateY(0);
    opacity: 0.75;
  }
  50% {
    transform: translateY(6px);
    opacity: 1;
  }
}

/* ==========================================================================
   Aspect Ratio Responsive Scaling Rules
   ========================================================================== */

/* 1. Ultra-Wide Displays (e.g. 21:9, 18:9, aspect-ratio >= 2.0) */
@media (min-aspect-ratio: 18/9) and (min-width: 769px) {
  #tenderlens-doodle-root .dcf-svg {
    width: clamp(960px, 96vw, 1920px);
    max-height: 54vh;
  }
  .tenderlens-doodle-stage {
    min-height:  240px; max-height: 280px; padding: 20px 0 10px;
  }
}

/* 2. Standard Widescreen (16:9, 16:10, e.g. 1920x1080, 1440x900) */
@media (min-aspect-ratio: 14/9) and (max-aspect-ratio: 18/9) and (min-width: 769px) {
  #tenderlens-doodle-root .dcf-svg {
    width: clamp(780px, 95vw, 1760px);
    max-height: 50vh;
  }
  .tenderlens-doodle-stage {
    min-height:  240px; max-height: 280px; padding: 20px 0 10px;
  }
}

/* 3. Taller / Boxier Viewports (4:3, 5:4, iPad, vertical split screen) */
@media (max-aspect-ratio: 14/9) and (min-width: 769px) {
  #tenderlens-doodle-root .dcf-svg {
    width: clamp(620px, 94vw, 1480px);
    max-height: 42vh;
  }
  .tenderlens-doodle-stage {
    min-height:  240px; max-height: 280px; padding: 20px 0 10px;
  }
}

/* Desktop Long-Scroll Curtain Cover-Up Effect */
@media (min-width: 769px) {
  .tenderlens-doodle-stage {
    z-index: 1;
  }

  .tenderlens-doodle-sticky {
    position: sticky;
    top: 72px; /* Sits directly below the 72px sticky header banner */
    height: auto; min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 1;
    overflow: hidden;
    will-change: transform, opacity;
  }

  .tenderlens-curtain {
    position: relative;
    z-index: 25;
    background: var(--paper);
    box-shadow: 0 -20px 45px rgba(24, 51, 47, 0.12), 0 -1px 0 var(--line);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
}

/* ==========================================================================
   Mobile Devices: Fully Optimized UI & Seamless Touch Experience
   ========================================================================== */
@media (max-width: 768px) {
  .tenderlens-doodle-stage {
    position: relative !important;
    min-height: unset !important;
    height: auto !important;
    z-index: auto !important;
    padding: 16px 0 10px !important;
    overflow-x: hidden !important;
    touch-action: pan-y !important;
  }

  .tenderlens-doodle-sticky {
    position: relative !important;
    top: unset !important;
    height: auto !important;
    min-height: unset !important;
    overflow: visible !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: auto !important;
    transform: none !important;
    padding: 0 !important;
  }

  #tenderlens-doodle-root {
    min-height: unset !important;
    width: 100% !important;
    padding: 0 !important;
  }

  #tenderlens-doodle-root .dcf-world {
    padding: 4px 8px 8px !important;
    width: 100% !important;
    overflow-x: hidden !important;
  }

  #tenderlens-doodle-root .dcf-svg {
    /* Maximum legible width on mobile without causing horizontal overflow */
    width: 100% !important;
    max-width: calc(100vw - 16px) !important;
    height: auto !important;
    max-height: 220px !important;
    margin: 0 auto !important;
  }

  .tenderlens-curtain {
    position: relative !important;
    z-index: auto !important;
    box-shadow: none !important;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .doodle-scroll-cue {
    display: none !important;
  }
}

/* Extra small mobile devices (<= 380px, e.g. iPhone SE, small Androids) */
@media (max-width: 380px) {
  .tenderlens-doodle-stage {
    padding: 12px 0 6px !important;
  }

  #tenderlens-doodle-root .dcf-world {
    padding: 2px 4px 6px !important;
  }

  #tenderlens-doodle-root .dcf-svg {
    max-width: calc(100vw - 10px) !important;
    max-height: 180px !important;
  }
}

/* ==========================================================================
   TENDERLENS ARCHITECTURE COMPARISON & TECH STACK (IMAGES 1 & 2)
   ========================================================================== */

/* Dual Panel Comparison Grid */
.engine-comparison-grid {
  display: grid;
  grid-template-columns: 1fr 1.65fr;
  gap: 24px;
  align-items: stretch;
  margin-top: 32px;
}

.engine-panel {
  border-radius: 14px;
  padding: 24px 22px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.engine-panel-flawed {
  background: rgba(239, 68, 68, 0.03);
  border: 1px solid rgba(239, 68, 68, 0.28);
}

.engine-panel-intelligent {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(56, 189, 248, 0.35);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(56, 189, 248, 0.15);
}

.panel-badge {
  display: inline-flex;
  align-items: center;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 9999px;
  width: fit-content;
  margin-bottom: 12px;
}

.panel-badge-flawed {
  background: rgba(239, 68, 68, 0.14);
  color: #fca5a5;
  border: 1px solid rgba(239, 68, 68, 0.35);
}

.panel-badge-intelligent {
  background: rgba(56, 189, 248, 0.14);
  color: #7dd3fc;
  border: 1px solid rgba(56, 189, 248, 0.35);
}

.panel-title {
  font-size: 1.5rem;
  font-family: var(--font-serif, serif);
  font-weight: 600;
  margin: 0 0 4px;
  color: var(--ink, #f8fafc);
}

.panel-subtitle {
  font-size: 0.875rem;
  color: var(--text-muted, #94a3b8);
  margin: 0 0 20px;
  line-height: 1.45;
}

/* Left Panel Flawed Flow */
.flawed-flow-diagram {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
}

.flawed-input-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.flawed-box {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px dashed rgba(239, 68, 68, 0.4);
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 0.8125rem;
  color: #fca5a5;
}

.flawed-or {
  font-size: 0.75rem;
  color: var(--text-muted, #94a3b8);
  text-transform: uppercase;
}

.flawed-alert-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: rgba(239, 68, 68, 0.12);
  border: 1px solid rgba(239, 68, 68, 0.3);
  padding: 8px 12px;
  border-radius: 8px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #fca5a5;
  text-align: center;
}

.flawed-hazards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.hazard-card {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hazard-card h4 {
  font-size: 0.875rem;
  font-weight: 600;
  color: #f87171;
  margin: 0;
}

.hazard-formula {
  font-family: var(--font-mono, monospace);
  font-size: 0.75rem;
  background: rgba(239, 68, 68, 0.08);
  padding: 3px 6px;
  border-radius: 4px;
  color: #fca5a5;
  margin: 2px 0 4px;
}

.hazard-desc {
  font-size: 0.75rem;
  color: #94a3b8;
  line-height: 1.4;
  margin: 0;
}

.hazard-bottom-row .hazard-card-warning {
  border-color: rgba(245, 158, 11, 0.3);
  background: rgba(245, 158, 11, 0.04);
}

.hazard-bottom-row .hazard-card-warning h4 {
  color: #fbbf24;
}

.flawed-footer-alerts {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-top: 14px;
  border-top: 1px solid rgba(239, 68, 68, 0.15);
}

.flawed-alert-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.78125rem;
  color: #fca5a5;
}

/* Right Panel Intelligent Architecture */
.intelligent-pipeline-stepper {
  display: grid;
  grid-template-columns: 1fr auto 1.35fr auto 1fr;
  gap: 8px;
  align-items: center;
  margin-bottom: 16px;
}

.pipeline-step-card {
  background: rgba(30, 41, 59, 0.65);
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: 10px;
