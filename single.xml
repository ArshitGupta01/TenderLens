.tender-facts small { color: #94a097; font: 7px var(--mono); letter-spacing: .07em; }
.tender-facts strong { color: var(--ink); font-size: 11px; font-weight: 600; }
.tender-card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-top: 15px; }
.focus-pill { padding: 5px 7px; font: 7px var(--mono); letter-spacing: .03em; }
.focus-review { color: #9a632f; background: #f8eee2; }
.focus-check { color: #60736a; background: #eff1eb; }
.preview-tender { display: inline-flex; align-items: center; gap: 8px; padding: 4px 0 4px 7px; border: 0; color: var(--green); background: transparent; font-size: 9px; font-weight: 700; cursor: pointer; }
.preview-tender span { color: var(--coral); font-size: 13px; transition: transform .18s ease; }
.preview-tender:hover span { transform: translate(2px, -2px); }
.empty-state { margin: 15px 0 0; padding: 24px; border: 1px dashed var(--line-strong); color: var(--muted); text-align: center; font-size: 11px; }
.tender-dialog { width: min(560px, calc(100% - 32px)); max-width: 560px; max-height: min(88vh, 760px); padding: 0; border: 1px solid #ced8cf; color: var(--ink); background: var(--surface); box-shadow: 0 28px 90px rgba(16, 36, 31, .24); }
.tender-dialog[open] { animation: dialog-in .22s ease-out both; }
.tender-dialog::backdrop { background: rgba(14, 33, 29, .56); backdrop-filter: blur(3px); }
@keyframes dialog-in { from { opacity: 0; transform: translateY(10px) scale(.99); } to { opacity: 1; transform: none; } }
.dialog-top { display: flex; align-items: center; justify-content: space-between; padding: 14px 19px; color: #d9e6dc; background: var(--green-dark); }
.dialog-label { color: #b9cfc1; font-size: 7px; }
.dialog-close { width: 28px; height: 28px; border: 1px solid #58776b; color: white; background: transparent; font-size: 19px; cursor: pointer; }
.dialog-content { padding: 25px clamp(20px, 5vw, 38px) 31px; }
.dialog-content .eyebrow { margin-bottom: 10px; font-size: 8px; }
.dialog-content h2 { margin: 0; font: 500 clamp(32px, 6vw, 44px)/1.05 var(--serif); letter-spacing: -.035em; }
.dialog-buyer { margin: 10px 0 21px; color: var(--muted); font-size: 10px; }
.dialog-facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.dialog-fact { padding: 12px; border: 1px solid var(--line); background: #f8f7f1; }
