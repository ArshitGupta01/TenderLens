    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

tinyfish = TinyFishService()

# In-memory pipeline task event bus for SSE streaming
pipeline_task_events: Dict[str, asyncio.Queue] = {}


# Request Models
class SearchRequest(BaseModel):
