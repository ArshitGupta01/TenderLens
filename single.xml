.brand { display: flex; align-items: center; min-width: 310px; gap: 9px; }
.brand-mark { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.brand-mark svg { width: 100%; height: 100%; display: block; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, .16); }
.brand-name { color: var(--ink); font-size: 19px; font-weight: 700; letter-spacing: -.065em; }
.brand-name span { color: var(--green); font-weight: 500; }
.brand-descriptor { margin-left: 8px; padding-left: 15px; border-left: 1px solid var(--line-strong); color: var(--muted); font: 9px var(--mono); letter-spacing: .1em; }
.primary-nav { display: none; }
.menu-toggle { display: inline-flex; }

.hero { position: relative; padding: 65px 0 52px; overflow: hidden; background: var(--paper); }
