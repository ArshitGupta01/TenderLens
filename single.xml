                    numerical_gap_lakhs_or_years=shortfall,
                    bridging_strategy=(
                        f"Form a Consortium / Joint Venture with a financial partner contributing at least "
                        f"₹{shortfall:.2f} Lakhs in average annual turnover."
                    )
                ))

