}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 96px; }
body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }
button:focus-visible, a:focus-visible { outline: 3px solid #bf6a4a; outline-offset: 4px; }
::selection { color: var(--surface); background: var(--green); }
.container { width: min(var(--container), calc(100% - 96px)); margin-inline: auto; }
.section-rule { border-bottom: 1px solid var(--line); }
.skip-link { position: fixed; z-index: 100; top: 10px; left: 10px; padding: 10px 14px; color: white; background: var(--ink); transform: translateY(-160%); }
.skip-link:focus { transform: translateY(0); }

.site-header { height: 82px; border-bottom: 1px solid var(--line); background: rgba(244, 242, 233, .96); }
