.not-found h1 em { color: var(--green); }
.not-found p { max-width: 420px; margin: 17px auto 23px; color: var(--muted); font-size: 12px; line-height: 1.8; }

.scroll-progress { position: fixed; z-index: 101; top: 0; left: 0; width: 100%; height: 3px; pointer-events: none; }
.scroll-progress span { display: block; width: 100%; height: 100%; background: var(--coral); transform: scaleX(0); transform-origin: left center; }
.site-header { position: sticky; z-index: 50; top: 0; backdrop-filter: blur(16px); transition: background-color .25s ease, box-shadow .25s ease; }
.site-header.is-scrolled { background: rgba(244, 242, 233, .92); box-shadow: 0 8px 25px rgba(24, 51, 47, .06); }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

.opportunity-section { padding: 100px 0 108px; background: #eeeee5; }
.section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .55fr); align-items: end; gap: 60px; margin-bottom: 33px; }
